<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_JobApplicantRecruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_JobApplicantRecruitment" name="Job Applicant Recruitment" isExecutable="true">
    <bpmn:documentation>HR recruitment: eligibility screening, technical interview, HR/managerial round, offer letter.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_ApplicationSubmitted" name="Job application submitted">
      <bpmn:documentation>Candidate submits a job application online.</bpmn:documentation>
      <bpmn:outgoing>Flow_ApplicationSubmitted_to_ScreenApplication</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_ScreenApplication" name="Screen application against eligibility criteria">
      <bpmn:documentation>HR system screens the application against the minimum eligibility criteria.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="screen-application" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplicationSubmitted_to_ScreenApplication</bpmn:incoming>
      <bpmn:outgoing>Flow_ScreenApplication_to_MeetsCriteria</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MeetsCriteria" name="Meets eligibility criteria?">
      <bpmn:incoming>Flow_ScreenApplication_to_MeetsCriteria</bpmn:incoming>
      <bpmn:outgoing>Flow_MeetsCriteria_to_ScheduleTechInterview</bpmn:outgoing>
      <bpmn:outgoing>Flow_MeetsCriteria_to_RejectScreening</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ScheduleTechInterview" name="Schedule technical interview">
      <bpmn:documentation>HR team schedules a technical interview with the candidate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-scheduletechinterview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MeetsCriteria_to_ScheduleTechInterview</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleTechInterview_to_EvaluateTechInterview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_EvaluateTechInterview" name="Evaluate technical interview">
      <bpmn:documentation>Technical panel evaluates the candidate's performance in the interview.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-evaluatetechinterview" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScheduleTechInterview_to_EvaluateTechInterview</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluateTechInterview_to_PassedTechnical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PassedTechnical" name="Passed technical interview?">
      <bpmn:incoming>Flow_EvaluateTechInterview_to_PassedTechnical</bpmn:incoming>
      <bpmn:outgoing>Flow_PassedTechnical_to_ScheduleHRRound</bpmn:outgoing>
      <bpmn:outgoing>Flow_PassedTechnical_to_RejectTechnical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ScheduleHRRound" name="Schedule HR/managerial round">
      <bpmn:documentation>HR schedules the candidate for the HR/managerial round.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-schedulehrround" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PassedTechnical_to_ScheduleHRRound</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleHRRound_to_ConductHRRound</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_ConductHRRound" name="Conduct HR/managerial round">
      <bpmn:documentation>HR/manager interviews the candidate and decides whether to select them.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-conducthrround" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScheduleHRRound_to_ConductHRRound</bpmn:incoming>
      <bpmn:outgoing>Flow_ConductHRRound_to_SelectedHR</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SelectedHR" name="Selected in HR round?">
      <bpmn:incoming>Flow_ConductHRRound_to_SelectedHR</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectedHR_to_GenerateOffer</bpmn:outgoing>
      <bpmn:outgoing>Flow_SelectedHR_to_RejectHRRound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_GenerateOffer" name="Generate offer letter">
      <bpmn:documentation>System generates the offer letter for the selected candidate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-offer-letter" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SelectedHR_to_GenerateOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_GenerateOffer_to_SendOffer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_SendOffer" name="Send offer letter to candidate">
      <bpmn:documentation>System sends the offer letter to the candidate.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-offer-letter" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GenerateOffer_to_SendOffer</bpmn:incoming>
      <bpmn:outgoing>Flow_SendOffer_to_OfferSent</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_OfferSent" name="Offer letter sent">
      <bpmn:incoming>Flow_SendOffer_to_OfferSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_RejectScreening" name="Send rejection notification">
      <bpmn:documentation>System sends a rejection notification: candidate does not meet the eligibility criteria.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-screening-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MeetsCriteria_to_RejectScreening</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectScreening_to_RejectedScreening</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_RejectedScreening" name="Rejected at screening">
      <bpmn:incoming>Flow_RejectScreening_to_RejectedScreening</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_RejectTechnical" name="Send rejection notification">
      <bpmn:documentation>HR sends a rejection notification: candidate failed the technical interview.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-rejecttechnical" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PassedTechnical_to_RejectTechnical</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectTechnical_to_RejectedTechnical</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RejectedTechnical" name="Rejected in technical interview">
      <bpmn:incoming>Flow_RejectTechnical_to_RejectedTechnical</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_RejectHRRound" name="Send rejection notification">
      <bpmn:documentation>A rejection notification is sent: candidate rejected in the HR/managerial round.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-hr-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SelectedHR_to_RejectHRRound</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectHRRound_to_RejectedHRRound</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_RejectedHRRound" name="Rejected in HR round">
      <bpmn:incoming>Flow_RejectHRRound_to_RejectedHRRound</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ApplicationSubmitted_to_ScreenApplication" sourceRef="StartEvent_ApplicationSubmitted" targetRef="Activity_ScreenApplication" />
    <bpmn:sequenceFlow id="Flow_ScreenApplication_to_MeetsCriteria" sourceRef="Activity_ScreenApplication" targetRef="Gateway_MeetsCriteria" />
    <bpmn:sequenceFlow id="Flow_MeetsCriteria_to_ScheduleTechInterview" name="Yes" sourceRef="Gateway_MeetsCriteria" targetRef="Activity_ScheduleTechInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=meetsCriteria = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MeetsCriteria_to_RejectScreening" name="No" sourceRef="Gateway_MeetsCriteria" targetRef="Activity_RejectScreening">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=meetsCriteria = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectScreening_to_RejectedScreening" sourceRef="Activity_RejectScreening" targetRef="EndEvent_RejectedScreening" />
    <bpmn:sequenceFlow id="Flow_ScheduleTechInterview_to_EvaluateTechInterview" sourceRef="Activity_ScheduleTechInterview" targetRef="Activity_EvaluateTechInterview" />
    <bpmn:sequenceFlow id="Flow_EvaluateTechInterview_to_PassedTechnical" sourceRef="Activity_EvaluateTechInterview" targetRef="Gateway_PassedTechnical" />
    <bpmn:sequenceFlow id="Flow_PassedTechnical_to_ScheduleHRRound" name="Yes" sourceRef="Gateway_PassedTechnical" targetRef="Activity_ScheduleHRRound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=passedTechnical = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PassedTechnical_to_RejectTechnical" name="No" sourceRef="Gateway_PassedTechnical" targetRef="Activity_RejectTechnical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=passedTechnical = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectTechnical_to_RejectedTechnical" sourceRef="Activity_RejectTechnical" targetRef="EndEvent_RejectedTechnical" />
    <bpmn:sequenceFlow id="Flow_ScheduleHRRound_to_ConductHRRound" sourceRef="Activity_ScheduleHRRound" targetRef="Activity_ConductHRRound" />
    <bpmn:sequenceFlow id="Flow_ConductHRRound_to_SelectedHR" sourceRef="Activity_ConductHRRound" targetRef="Gateway_SelectedHR" />
    <bpmn:sequenceFlow id="Flow_SelectedHR_to_GenerateOffer" name="Yes" sourceRef="Gateway_SelectedHR" targetRef="Activity_GenerateOffer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selected = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SelectedHR_to_RejectHRRound" name="No" sourceRef="Gateway_SelectedHR" targetRef="Activity_RejectHRRound">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=selected = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectHRRound_to_RejectedHRRound" sourceRef="Activity_RejectHRRound" targetRef="EndEvent_RejectedHRRound" />
    <bpmn:sequenceFlow id="Flow_GenerateOffer_to_SendOffer" sourceRef="Activity_GenerateOffer" targetRef="Activity_SendOffer" />
    <bpmn:sequenceFlow id="Flow_SendOffer_to_OfferSent" sourceRef="Activity_SendOffer" targetRef="EndEvent_OfferSent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_JobApplicantRecruitment">
    <bpmndi:BPMNPlane id="BPMNPlane_JobApplicantRecruitment" bpmnElement="Process_JobApplicantRecruitment">
      <bpmndi:BPMNShape id="StartEvent_ApplicationSubmitted_di" bpmnElement="StartEvent_ApplicationSubmitted">
        <dc:Bounds x="150" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="205" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ScreenApplication_di" bpmnElement="Activity_ScreenApplication">
