        <dc:Bounds x="1201" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedHRRound_di" bpmnElement="EndEvent_RejectedHRRound">
        <dc:Bounds x="1373" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1346" y="375" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ApplicationSubmitted_to_ScreenApplication_di" bpmnElement="Flow_ApplicationSubmitted_to_ScreenApplication">
        <di:waypoint x="186" y="180" />
        <di:waypoint x="241" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScreenApplication_to_MeetsCriteria_di" bpmnElement="Flow_ScreenApplication_to_MeetsCriteria">
        <di:waypoint x="341" y="180" />
        <di:waypoint x="396" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MeetsCriteria_to_ScheduleTechInterview_di" bpmnElement="Flow_MeetsCriteria_to_ScheduleTechInterview">
        <di:waypoint x="446" y="180" />
        <di:waypoint x="501" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_MeetsCriteria_to_RejectScreening_di" bpmnElement="Flow_MeetsCriteria_to_RejectScreening">
        <di:waypoint x="421" y="205" />
        <di:waypoint x="421" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="429" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectScreening_to_RejectedScreening_di" bpmnElement="Flow_RejectScreening_to_RejectedScreening">
        <di:waypoint x="471" y="350" />
        <di:waypoint x="543" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScheduleTechInterview_to_EvaluateTechInterview_di" bpmnElement="Flow_ScheduleTechInterview_to_EvaluateTechInterview">
        <di:waypoint x="601" y="180" />
        <di:waypoint x="656" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EvaluateTechInterview_to_PassedTechnical_di" bpmnElement="Flow_EvaluateTechInterview_to_PassedTechnical">
        <di:waypoint x="756" y="180" />
        <di:waypoint x="811" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PassedTechnical_to_ScheduleHRRound_di" bpmnElement="Flow_PassedTechnical_to_ScheduleHRRound">
        <di:waypoint x="861" y="180" />
        <di:waypoint x="916" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="867" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PassedTechnical_to_RejectTechnical_di" bpmnElement="Flow_PassedTechnical_to_RejectTechnical">
        <di:waypoint x="836" y="205" />
        <di:waypoint x="836" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="844" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectTechnical_to_RejectedTechnical_di" bpmnElement="Flow_RejectTechnical_to_RejectedTechnical">
        <di:waypoint x="886" y="350" />
        <di:waypoint x="958" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ScheduleHRRound_to_ConductHRRound_di" bpmnElement="Flow_ScheduleHRRound_to_ConductHRRound">
        <di:waypoint x="1016" y="180" />
        <di:waypoint x="1071" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConductHRRound_to_SelectedHR_di" bpmnElement="Flow_ConductHRRound_to_SelectedHR">
        <di:waypoint x="1171" y="180" />
        <di:waypoint x="1226" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SelectedHR_to_GenerateOffer_di" bpmnElement="Flow_SelectedHR_to_GenerateOffer">
        <di:waypoint x="1276" y="180" />
        <di:waypoint x="1331" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1282" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SelectedHR_to_RejectHRRound_di" bpmnElement="Flow_SelectedHR_to_RejectHRRound">
        <di:waypoint x="1251" y="205" />
        <di:waypoint x="1251" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1259" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectHRRound_to_RejectedHRRound_di" bpmnElement="Flow_RejectHRRound_to_RejectedHRRound">
        <di:waypoint x="1301" y="350" />
        <di:waypoint x="1373" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GenerateOffer_to_SendOffer_di" bpmnElement="Flow_GenerateOffer_to_SendOffer">
        <di:waypoint x="1431" y="180" />
        <di:waypoint x="1486" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendOffer_to_OfferSent_di" bpmnElement="Flow_SendOffer_to_OfferSent">
        <di:waypoint x="1586" y="180" />
        <di:waypoint x="1641" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
