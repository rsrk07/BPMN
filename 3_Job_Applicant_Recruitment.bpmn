      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendOffer_di" bpmnElement="Activity_SendOffer">
        <dc:Bounds x="1486" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OfferSent_di" bpmnElement="EndEvent_OfferSent">
