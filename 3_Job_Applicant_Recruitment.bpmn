        <dc:Bounds x="1071" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SelectedHR_di" bpmnElement="Gateway_SelectedHR" isMarkerVisible="true">
        <dc:Bounds x="1226" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1191" y="115" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
