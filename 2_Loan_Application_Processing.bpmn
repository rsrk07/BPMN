<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_LoanApplicationProcessing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_LoanApplicationProcessing" name="Loan Application Processing" isExecutable="true">
    <bpmn:documentation>Personal loan application: document and credit check, eligibility, loan officer approval.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_LoanApplicationSubmitted" name="Loan application submitted">
      <bpmn:documentation>Customer submits a personal loan application.</bpmn:documentation>
      <bpmn:outgoing>Flow_LoanApplicationSubmitted_to_VerifyDocuments</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_VerifyDocuments" name="Verify documents and credit score">
      <bpmn:documentation>Bank system verifies the applicant's documents and credit score.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-documents-credit" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LoanApplicationSubmitted_to_VerifyDocuments</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyDocuments_to_DocumentsValid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DocumentsValid" name="Documents complete and valid?">
      <bpmn:incoming>Flow_VerifyDocuments_to_DocumentsValid</bpmn:incoming>
      <bpmn:outgoing>Flow_DocumentsValid_to_CheckEligibility</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocumentsValid_to_RejectInvalidDocs</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_CheckEligibility" name="Check eligibility (credit score and income)">
      <bpmn:documentation>System checks the applicant's eligibility based on credit score and income.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-eligibility" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocumentsValid_to_CheckEligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckEligibility_to_ApplicantEligible</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ApplicantEligible" name="Applicant eligible?">
      <bpmn:incoming>Flow_CheckEligibility_to_ApplicantEligible</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplicantEligible_to_ReviewLoan</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApplicantEligible_to_NotifyNotEligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ReviewLoan" name="Review loan for final approval">
      <bpmn:documentation>Loan officer reviews the forwarded application and approves or rejects the loan.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-reviewloan" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplicantEligible_to_ReviewLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewLoan_to_LoanApproved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_LoanApproved" name="Loan approved?">
      <bpmn:incoming>Flow_ReviewLoan_to_LoanApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_LoanApproved_to_DisburseLoan</bpmn:outgoing>
      <bpmn:outgoing>Flow_LoanApproved_to_SendLoanRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_DisburseLoan" name="Disburse loan amount">
      <bpmn:documentation>System disburses the approved loan amount to the customer.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="disburse-loan" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LoanApproved_to_DisburseLoan</bpmn:incoming>
      <bpmn:outgoing>Flow_DisburseLoan_to_SendApproval</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_SendApproval" name="Send approval notification">
      <bpmn:documentation>System sends the loan approval notification to the customer.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-approval-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DisburseLoan_to_SendApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_SendApproval_to_LoanDisbursed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_LoanDisbursed" name="Loan approved and disbursed">
      <bpmn:incoming>Flow_SendApproval_to_LoanDisbursed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_RejectInvalidDocs" name="Reject application and notify customer">
      <bpmn:documentation>System rejects the application because documents are incomplete or invalid, and notifies the customer.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-invalid-documents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocumentsValid_to_RejectInvalidDocs</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectInvalidDocs_to_RejectedInvalidDocs</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_RejectedInvalidDocs" name="Application rejected (invalid documents)">
      <bpmn:incoming>Flow_RejectInvalidDocs_to_RejectedInvalidDocs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_NotifyNotEligible" name="Send rejection notification">
      <bpmn:documentation>Loan officer sends a rejection notification to the customer (not eligible).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-notifynoteligible" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplicantEligible_to_NotifyNotEligible</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyNotEligible_to_RejectedNotEligible</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RejectedNotEligible" name="Application rejected (not eligible)">
      <bpmn:incoming>Flow_NotifyNotEligible_to_RejectedNotEligible</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_SendLoanRejection" name="Send rejection notification">
      <bpmn:documentation>System sends a rejection notification to the customer after the loan officer rejects the loan.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LoanApproved_to_SendLoanRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_SendLoanRejection_to_LoanRejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_LoanRejected" name="Loan rejected">
      <bpmn:incoming>Flow_SendLoanRejection_to_LoanRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_LoanApplicationSubmitted_to_VerifyDocuments" sourceRef="StartEvent_LoanApplicationSubmitted" targetRef="Activity_VerifyDocuments" />
    <bpmn:sequenceFlow id="Flow_VerifyDocuments_to_DocumentsValid" sourceRef="Activity_VerifyDocuments" targetRef="Gateway_DocumentsValid" />
    <bpmn:sequenceFlow id="Flow_DocumentsValid_to_CheckEligibility" name="Yes" sourceRef="Gateway_DocumentsValid" targetRef="Activity_CheckEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentsValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocumentsValid_to_RejectInvalidDocs" name="No" sourceRef="Gateway_DocumentsValid" targetRef="Activity_RejectInvalidDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentsValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RejectInvalidDocs_to_RejectedInvalidDocs" sourceRef="Activity_RejectInvalidDocs" targetRef="EndEvent_RejectedInvalidDocs" />
    <bpmn:sequenceFlow id="Flow_CheckEligibility_to_ApplicantEligible" sourceRef="Activity_CheckEligibility" targetRef="Gateway_ApplicantEligible" />
    <bpmn:sequenceFlow id="Flow_ApplicantEligible_to_ReviewLoan" name="Yes" sourceRef="Gateway_ApplicantEligible" targetRef="Activity_ReviewLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApplicantEligible_to_NotifyNotEligible" name="No" sourceRef="Gateway_ApplicantEligible" targetRef="Activity_NotifyNotEligible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotifyNotEligible_to_RejectedNotEligible" sourceRef="Activity_NotifyNotEligible" targetRef="EndEvent_RejectedNotEligible" />
    <bpmn:sequenceFlow id="Flow_ReviewLoan_to_LoanApproved" sourceRef="Activity_ReviewLoan" targetRef="Gateway_LoanApproved" />
    <bpmn:sequenceFlow id="Flow_LoanApproved_to_DisburseLoan" name="Yes" sourceRef="Gateway_LoanApproved" targetRef="Activity_DisburseLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LoanApproved_to_SendLoanRejection" name="No" sourceRef="Gateway_LoanApproved" targetRef="Activity_SendLoanRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SendLoanRejection_to_LoanRejected" sourceRef="Activity_SendLoanRejection" targetRef="EndEvent_LoanRejected" />
    <bpmn:sequenceFlow id="Flow_DisburseLoan_to_SendApproval" sourceRef="Activity_DisburseLoan" targetRef="Activity_SendApproval" />
    <bpmn:sequenceFlow id="Flow_SendApproval_to_LoanDisbursed" sourceRef="Activity_SendApproval" targetRef="EndEvent_LoanDisbursed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LoanApplicationProcessing">
    <bpmndi:BPMNPlane id="BPMNPlane_LoanApplicationProcessing" bpmnElement="Process_LoanApplicationProcessing">
      <bpmndi:BPMNShape id="StartEvent_LoanApplicationSubmitted_di" bpmnElement="StartEvent_LoanApplicationSubmitted">
        <dc:Bounds x="150" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="123" y="205" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_VerifyDocuments_di" bpmnElement="Activity_VerifyDocuments">
        <dc:Bounds x="241" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DocumentsValid_di" bpmnElement="Gateway_DocumentsValid" isMarkerVisible="true">
        <dc:Bounds x="396" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="361" y="115" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CheckEligibility_di" bpmnElement="Activity_CheckEligibility">
        <dc:Bounds x="501" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApplicantEligible_di" bpmnElement="Gateway_ApplicantEligible" isMarkerVisible="true">
        <dc:Bounds x="656" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="621" y="115" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ReviewLoan_di" bpmnElement="Activity_ReviewLoan">
        <dc:Bounds x="761" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LoanApproved_di" bpmnElement="Gateway_LoanApproved" isMarkerVisible="true">
        <dc:Bounds x="916" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="881" y="115" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DisburseLoan_di" bpmnElement="Activity_DisburseLoan">
        <dc:Bounds x="1021" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendApproval_di" bpmnElement="Activity_SendApproval">
        <dc:Bounds x="1176" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanDisbursed_di" bpmnElement="EndEvent_LoanDisbursed">
        <dc:Bounds x="1331" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1304" y="205" width="90" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RejectInvalidDocs_di" bpmnElement="Activity_RejectInvalidDocs">
        <dc:Bounds x="371" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedInvalidDocs_di" bpmnElement="EndEvent_RejectedInvalidDocs">
        <dc:Bounds x="543" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="516" y="375" width="90" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_NotifyNotEligible_di" bpmnElement="Activity_NotifyNotEligible">
        <dc:Bounds x="631" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedNotEligible_di" bpmnElement="EndEvent_RejectedNotEligible">
        <dc:Bounds x="803" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="776" y="375" width="90" height="41" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SendLoanRejection_di" bpmnElement="Activity_SendLoanRejection">
        <dc:Bounds x="891" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_LoanRejected_di" bpmnElement="EndEvent_LoanRejected">
        <dc:Bounds x="1063" y="332" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1036" y="375" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_LoanApplicationSubmitted_to_VerifyDocuments_di" bpmnElement="Flow_LoanApplicationSubmitted_to_VerifyDocuments">
        <di:waypoint x="186" y="180" />
        <di:waypoint x="241" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VerifyDocuments_to_DocumentsValid_di" bpmnElement="Flow_VerifyDocuments_to_DocumentsValid">
        <di:waypoint x="341" y="180" />
        <di:waypoint x="396" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DocumentsValid_to_CheckEligibility_di" bpmnElement="Flow_DocumentsValid_to_CheckEligibility">
        <di:waypoint x="446" y="180" />
        <di:waypoint x="501" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DocumentsValid_to_RejectInvalidDocs_di" bpmnElement="Flow_DocumentsValid_to_RejectInvalidDocs">
        <di:waypoint x="421" y="205" />
        <di:waypoint x="421" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="429" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectInvalidDocs_to_RejectedInvalidDocs_di" bpmnElement="Flow_RejectInvalidDocs_to_RejectedInvalidDocs">
        <di:waypoint x="471" y="350" />
        <di:waypoint x="543" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CheckEligibility_to_ApplicantEligible_di" bpmnElement="Flow_CheckEligibility_to_ApplicantEligible">
        <di:waypoint x="601" y="180" />
        <di:waypoint x="656" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApplicantEligible_to_ReviewLoan_di" bpmnElement="Flow_ApplicantEligible_to_ReviewLoan">
        <di:waypoint x="706" y="180" />
        <di:waypoint x="761" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="712" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApplicantEligible_to_NotifyNotEligible_di" bpmnElement="Flow_ApplicantEligible_to_NotifyNotEligible">
        <di:waypoint x="681" y="205" />
        <di:waypoint x="681" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="689" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotifyNotEligible_to_RejectedNotEligible_di" bpmnElement="Flow_NotifyNotEligible_to_RejectedNotEligible">
        <di:waypoint x="731" y="350" />
        <di:waypoint x="803" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewLoan_to_LoanApproved_di" bpmnElement="Flow_ReviewLoan_to_LoanApproved">
        <di:waypoint x="861" y="180" />
        <di:waypoint x="916" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LoanApproved_to_DisburseLoan_di" bpmnElement="Flow_LoanApproved_to_DisburseLoan">
        <di:waypoint x="966" y="180" />
        <di:waypoint x="1021" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="972" y="160" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LoanApproved_to_SendLoanRejection_di" bpmnElement="Flow_LoanApproved_to_SendLoanRejection">
        <di:waypoint x="941" y="205" />
        <di:waypoint x="941" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="949" y="217" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendLoanRejection_to_LoanRejected_di" bpmnElement="Flow_SendLoanRejection_to_LoanRejected">
        <di:waypoint x="991" y="350" />
        <di:waypoint x="1063" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DisburseLoan_to_SendApproval_di" bpmnElement="Flow_DisburseLoan_to_SendApproval">
        <di:waypoint x="1121" y="180" />
        <di:waypoint x="1176" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendApproval_to_LoanDisbursed_di" bpmnElement="Flow_SendApproval_to_LoanDisbursed">
        <di:waypoint x="1276" y="180" />
        <di:waypoint x="1331" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
